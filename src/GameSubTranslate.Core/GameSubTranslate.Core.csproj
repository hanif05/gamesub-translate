<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>GameSubTranslate</RootNamespace>
    <AssemblyName>GameSubTranslate.Core</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Win2D 1.3.1 depends on Microsoft.WindowsAppSDK, whose MrtCore.PriGen.targets
         requires Visual-Studio-only MSBuild tasks that break `dotnet build` on a
         non-VS machine. Core is a non-XAML classlib, so PRI tooling is unneeded. -->
    <EnableCoreMrtTooling>false</EnableCoreMrtTooling>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.1" />
    <!-- Sdcb.PaddleOCR (Apache-2.0) replaces raoyutian PaddleOCRSharp because the latter's
         free NuGet is CPU-only (commercial license required for CUDA). Sdcb exposes
         PaddleDevice.Gpu() and ships a free cu runtime variant — pick the sm version
         that matches the user's GPU. cu120-sm61-75 covers GTX 10/16 series (sm_61, sm_75)
         — the GTX 1650 Ti (Turing, sm_75) shipped in the user's hardware. RTX 30/40
         users would swap to cu120-sm86 or cu120-sm89 in a future iteration. Versions
         must stay aligned: Sdcb.PaddleOCR 2.7.0.1 ↔ Sdcb.PaddleOCR.Models.Online 2.7.0
         (each Models.Online release pins to a specific OCR version — confirmed via
         MissingMethodException when OCR 2.7.0.1 was paired with Models.Online 2.5.0). -->
    <PackageReference Include="Sdcb.PaddleOCR" Version="2.7.0.3" />
    <PackageReference Include="Sdcb.PaddleOCR.Models.Online" Version="2.7.0" />
    <PackageReference Include="Sdcb.PaddleInference.runtime.win64.cu120-sm61-75" Version="2.6.1" />
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20240616" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20240616" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\assets\tessdata\*.traineddata" Link="tessdata\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- T40: tests set TranslationClient.PrimaryRetryAfter to shrink the failover window.
         T42: App self-checks also shrink this + FileLogger rotation ceiling to keep tests fast. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>GameSubTranslate.Core.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>GameSubTranslate.App</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
