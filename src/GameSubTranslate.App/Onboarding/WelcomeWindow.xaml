<Window x:Class="GameSubTranslate.App.Onboarding.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to GameSubTranslate"
        Width="560" MinHeight="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        ShowInTaskbar="True"
        Icon="pack://application:,,,/App.ico"
        Style="{StaticResource Window.Base}">
    <Window.Resources>
        <!-- F65: feature card style for the Step 3 tour tiles. -->
        <Style x:Key="FeatureCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource Brush.Bg.Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Border>
        <!-- F65: subtle top-to-bottom gradient — dark to slightly lighter. -->
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF1A1A1F" Offset="0"/>
                <GradientStop Color="#FF24242B" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- F65: header strip — app name + tagline. -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="GameSubTranslate" FontWeight="SemiBold" FontSize="16"
                           Foreground="{StaticResource Brush.Text.Primary}" VerticalAlignment="Center"/>
                <TextBlock Text="  ·  Real-time subtitle translation for your games"
                           Foreground="{StaticResource Brush.Text.Muted}" FontSize="11"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- F57: filled/outlined circle step indicator. -->
            <StackPanel x:Name="StepIndicator" Grid.Row="1" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,0,0,16">
                <TextBlock x:Name="Dot1" FontFamily="Segoe Fluent Icons" Text="&#xEA3A;" FontSize="14" Margin="4,0"/>
                <TextBlock x:Name="Dot2" FontFamily="Segoe Fluent Icons" Text="&#xEA3A;" FontSize="14" Margin="4,0"/>
                <TextBlock x:Name="Dot3" FontFamily="Segoe Fluent Icons" Text="&#xEA3A;" FontSize="14" Margin="4,0"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,0,0,14">
                <TextBlock x:Name="StepTitle" FontSize="22" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.Text.Primary}" Margin="0,0,0,6"/>
                <TextBlock x:Name="StepHint" Foreground="{StaticResource Brush.Text.Muted}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- ===== Step 1: API setup ===== -->
            <StackPanel x:Name="Step1" Grid.Row="3" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE73E;" FontSize="32"
                               Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center"/>
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8AE;" FontSize="22"
                               Foreground="{StaticResource Brush.Text.Muted}" VerticalAlignment="Center" Margin="8,0"/>
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8A5;" FontSize="32"
                               Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Base URL" FontWeight="SemiBold"/>
                <TextBox x:Name="BaseUrlBox" Margin="0,4,0,12"/>
                <TextBlock Text="Model" FontWeight="SemiBold"/>
                <TextBox x:Name="ModelBox" Margin="0,4,0,12"/>
                <TextBlock Text="API Key" FontWeight="SemiBold"/>
                <PasswordBox x:Name="ApiKeyBox" Margin="0,4,0,12"/>
                <Expander x:Name="WhyNeed" Header="Why we need this" Foreground="{StaticResource Brush.Text.Muted}"
                          Margin="0,4,0,0">
                    <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource Brush.Text.Muted}" FontSize="12">
                        Your screen captures stay on your machine. Only the OCR'd text is sent to your chosen API for translation.
                        The key is stored locally — never transmitted anywhere else.
                    </TextBlock>
                </Expander>
            </StackPanel>

            <!-- ===== Step 2: target language ===== -->
            <StackPanel x:Name="Step2" Grid.Row="3" Visibility="Collapsed">
                <TextBlock Text="Target language" FontWeight="SemiBold"/>
                <ComboBox x:Name="TargetLangBox" Margin="0,4,0,12" IsEditable="True">
                    <ComboBoxItem Content="id"/>
                    <ComboBoxItem Content="en"/>
                    <ComboBoxItem Content="ja"/>
                    <ComboBoxItem Content="ko"/>
                    <ComboBoxItem Content="zh"/>
                    <ComboBoxItem Content="fr"/>
                    <ComboBoxItem Content="de"/>
                    <ComboBoxItem Content="es"/>
                </ComboBox>
                <TextBlock Text="Source language is auto-detected by default — you can change it in Settings."
                           Foreground="{StaticResource Brush.Text.Muted}" TextWrapping="Wrap" FontSize="12"/>
            </StackPanel>

            <!-- ===== Step 3: quick tour ===== -->
            <StackPanel x:Name="Step3" Grid.Row="3" Visibility="Collapsed">
                <Border Style="{StaticResource FeatureCard}">
                    <StackPanel>
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE7FC;" FontSize="20"
                                   Foreground="{StaticResource Brush.Accent}" Margin="0,0,0,6"/>
                        <TextBlock Text="Auto-load profile" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Brush.Text.Muted}" FontSize="12">
                            When a game you have a profile for comes to the foreground, GameSubTranslate switches to it automatically.
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource FeatureCard}">
                    <StackPanel>
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE765;" FontSize="20"
                                   Foreground="{StaticResource Brush.Accent}" Margin="0,0,0,6"/>
                        <TextBlock Text="Hotkey" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Brush.Text.Muted}" FontSize="12">
                            Ctrl+Alt+T toggles the overlay. Pause via Ctrl+Alt+P. Ctrl+Alt+Space for a one-shot capture.
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource FeatureCard}">
                    <StackPanel>
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE7E7;" FontSize="20"
                                   Foreground="{StaticResource Brush.Accent}" Margin="0,0,0,6"/>
                        <TextBlock Text="Tray icon" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Brush.Text.Muted}" FontSize="12">
                            Right-click for Show/Hide, Pause, Settings. Closing the main window keeps the app running in the tray.
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Footer buttons — Skip text-only on the left, Back/Next primary on the right. -->
            <Grid Grid.Row="4" Margin="0,18,0,0">
                <Button x:Name="SkipBtn" Content="Skip setup" HorizontalAlignment="Left"
                        Background="Transparent" BorderThickness="0" Foreground="{StaticResource Brush.Text.Muted}"
                        Click="Skip_Click" Cursor="Hand"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BackBtn" Content="Back" Width="90" Margin="0,0,6,0" Click="Back_Click"/>
                    <Button x:Name="NextBtn" Content="Next" Width="110" IsDefault="True"
                            Style="{StaticResource Button.Primary}" Click="Next_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
