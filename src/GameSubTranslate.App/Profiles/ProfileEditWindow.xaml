<Window x:Class="GameSubTranslate.App.Profiles.ProfileEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Profile" Height="540" Width="560" MinHeight="420" MinWidth="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Icon="pack://application:,,,/App.ico"
        Style="{StaticResource Window.Base}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- T68: header strip with icon + title. -->
        <Border Grid.Row="0" Padding="16,12" Background="{StaticResource Brush.Bg.Surface}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE7FC;" FontSize="18"
                           Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center"/>
                <TextBlock x:Name="HeaderTitle" Margin="10,0,0,0" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.Text.Primary}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- T68: required field = asterisk in red after the label. -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" VerticalAlignment="Center" Margin="0,4"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" Margin="0,4"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Executable name" VerticalAlignment="Center" Margin="0,4"/>
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="ExecutableBox" Margin="0,4"
                     ToolTip="Used by auto-load (T25). Example: game.exe"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Source language" VerticalAlignment="Center" Margin="0,4"/>
            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="SourceLangBox" Margin="0,4" IsEditable="True">
                <ComboBoxItem Content="auto"/>
                <ComboBoxItem Content="en"/>
                <ComboBoxItem Content="ja"/>
                <ComboBoxItem Content="ko"/>
                <ComboBoxItem Content="zh"/>
                <ComboBoxItem Content="es"/>
                <ComboBoxItem Content="fr"/>
                <ComboBoxItem Content="de"/>
            </ComboBox>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Target language" VerticalAlignment="Center" Margin="0,4"/>
            <ComboBox Grid.Row="3" Grid.Column="1" x:Name="TargetLangBox" Margin="0,4" IsEditable="True">
                <ComboBoxItem Content="id"/>
                <ComboBoxItem Content="en"/>
                <ComboBoxItem Content="ja"/>
            </ComboBox>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="OCR engine" VerticalAlignment="Center" Margin="0,4"/>
            <ComboBox Grid.Row="4" Grid.Column="1" x:Name="OcrEngineBox" Margin="0,4">
                <ComboBoxItem Content="Tesseract" Tag="Tesseract"/>
                <ComboBoxItem Content="Vision AI" Tag="VisionAi"/>
            </ComboBox>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Capture interval (ms)" VerticalAlignment="Center" Margin="0,4"/>
            <TextBox Grid.Row="5" Grid.Column="1" x:Name="IntervalBox" Margin="0,4"/>

            <!-- T68: regions section header + buttons above list. -->
            <TextBlock Grid.Row="6" Grid.Column="0" Text="Regions" VerticalAlignment="Top" Margin="0,12,0,0"
                       FontWeight="SemiBold"/>
            <DockPanel Grid.Row="6" Grid.Column="1" Margin="0,12,0,0" LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="Add Region..." Width="120" Margin="0,0,6,0" Click="AddRegion_Click"/>
                    <Button Content="Remove" Width="90" Click="RemoveRegion_Click"/>
                </StackPanel>
                <ListBox x:Name="RegionsList" MinHeight="140" DisplayMemberPath="Display"/>
            </DockPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16">
            <Button Content="Save" Width="100" Margin="0,0,6,0" IsDefault="True"
                    Style="{StaticResource Button.Primary}" Click="Save_Click"/>
            <Button Content="Cancel" Width="100" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
