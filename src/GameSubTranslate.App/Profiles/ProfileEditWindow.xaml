<Window x:Class="GameSubTranslate.App.Profiles.ProfileEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Profile" Height="500" Width="520" MinHeight="380" MinWidth="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Style="{StaticResource Window.Base}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name *" VerticalAlignment="Center" Margin="0,4"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" Margin="0,4" Padding="4,2"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Executable name" VerticalAlignment="Center" Margin="0,4"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="ExecutableBox" Margin="0,4" Padding="4,2"
                 ToolTip="Used by auto-load (T25). Example: game.exe"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Source language" VerticalAlignment="Center" Margin="0,4"/>
        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="SourceLangBox" Margin="0,4" IsEditable="True">
            <ComboBoxItem Content="auto"/>
            <ComboBoxItem Content="en"/>
            <ComboBoxItem Content="ja"/>
            <ComboBoxItem Content="ko"/>
            <ComboBoxItem Content="zh"/>
            <ComboBoxItem Content="es"/>
            <ComboBoxItem Content="fr"/>
            <ComboBoxItem Content="de"/>
        </ComboBox>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Target language" VerticalAlignment="Center" Margin="0,4"/>
        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="TargetLangBox" Margin="0,4" IsEditable="True">
            <ComboBoxItem Content="id"/>
            <ComboBoxItem Content="en"/>
            <ComboBoxItem Content="ja"/>
        </ComboBox>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="OCR engine" VerticalAlignment="Center" Margin="0,4"/>
        <ComboBox Grid.Row="4" Grid.Column="1" x:Name="OcrEngineBox" Margin="0,4">
            <ComboBoxItem Content="Tesseract" Tag="Tesseract"/>
            <ComboBoxItem Content="Vision AI" Tag="VisionAi"/>
        </ComboBox>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Capture interval (ms)" VerticalAlignment="Center" Margin="0,4"/>
        <TextBox Grid.Row="5" Grid.Column="1" x:Name="IntervalBox" Margin="0,4" Padding="4,2"/>

        <!-- Regions list -->
        <TextBlock Grid.Row="6" Grid.Column="0" Text="Regions" VerticalAlignment="Top" Margin="0,8,0,0"/>
        <DockPanel Grid.Row="6" Grid.Column="1" Margin="0,8,0,0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                <Button Content="Add Region..." Width="110" Margin="0,0,4,0" Click="AddRegion_Click"/>
                <Button Content="Remove" Width="80" Click="RemoveRegion_Click"/>
            </StackPanel>
            <ListBox x:Name="RegionsList" Height="120" DisplayMemberPath="Display"/>
        </DockPanel>

        <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save" Width="80" Margin="0,0,8,0" IsDefault="True" Click="Save_Click"/>
            <Button Content="Cancel" Width="80" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
