<Window x:Class="GameSubTranslate.App.Regions.RegionSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Region Selector"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowState="Normal" Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="Manual" Cursor="Cross"
        ResizeMode="NoResize">
    <Grid x:Name="RootGrid" Background="#33000000"
          MouseLeftButtonDown="RootGrid_MouseLeftButtonDown"
          MouseMove="RootGrid_MouseMove"
          MouseLeftButtonUp="RootGrid_MouseLeftButtonUp">
        <!-- T69: top bar — hint pill + monitor picker. -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0">
            <Border Background="#CC000000" Padding="14,8" CornerRadius="6" Margin="0,0,8,0">
                <TextBlock x:Name="HintText" Foreground="White" FontSize="13" Opacity="0.9"
                           Text="Drag to select subtitle region — ESC to cancel"/>
            </Border>
            <Border x:Name="MonitorPickerPanel" Background="#CC000000" Padding="10,6" CornerRadius="6" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="White" FontSize="13" Text="Monitor:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="MonitorPicker" FontSize="13" MinWidth="120" SelectionChanged="MonitorPicker_SelectionChanged"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- T69: live coords readout top-left in monospace. -->
        <Border Background="#CC000000" Padding="10,5" HorizontalAlignment="Left" VerticalAlignment="Top"
                CornerRadius="6" Margin="20,20,0,0">
            <TextBlock x:Name="CoordsText" Foreground="White" FontFamily="Consolas" FontSize="12"/>
        </Border>

        <!-- T69: selection rectangle — dashed accent, transparent fill. -->
        <Rectangle x:Name="SelectionRect" Visibility="Collapsed"
                   HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"
                   Stroke="{StaticResource Brush.Accent}" StrokeThickness="2"
                   StrokeDashArray="6 4" Fill="#207C8CFF"/>
    </Grid>
</Window>
