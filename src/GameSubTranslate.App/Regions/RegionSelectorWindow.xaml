<Window x:Class="GameSubTranslate.App.Regions.RegionSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Region Selector"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowState="Normal" Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="Manual" Cursor="Cross"
        ResizeMode="NoResize">
    <Grid x:Name="RootGrid" Background="#33000000"
          MouseLeftButtonDown="RootGrid_MouseLeftButtonDown"
          MouseMove="RootGrid_MouseMove"
          MouseLeftButtonUp="RootGrid_MouseLeftButtonUp">
        <!-- top hint bar -->
        <Border Background="#CC000000" Padding="12,6" HorizontalAlignment="Center" VerticalAlignment="Top" CornerRadius="4" Margin="0,20,0,0">
            <TextBlock x:Name="HintText" Foreground="White" FontSize="14"
                       Text="Drag to select subtitle region. ENTER = confirm, ESC = cancel."/>
        </Border>

        <!-- live coords readout -->
        <Border Background="#CC000000" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Bottom" CornerRadius="4" Margin="20,0,0,20">
            <TextBlock x:Name="CoordsText" Foreground="White" FontFamily="Consolas" FontSize="12"/>
        </Border>

        <!-- selection rectangle drawn during drag. Position is set via Margin in code-behind. -->
        <Rectangle x:Name="SelectionRect" Stroke="#FFFF5050" StrokeThickness="2" Fill="#40FF0000" Visibility="Collapsed"
                   HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>
    </Grid>
</Window>
