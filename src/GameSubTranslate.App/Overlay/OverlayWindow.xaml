<Window x:Class="GameSubTranslate.App.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Overlay" Width="800" Height="180"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="Manual" Topmost="True"
        AllowsTransparency="True" Background="Transparent">
    <Grid>
        <!-- T46: dropshadow Effect for readability on bright backgrounds. Padding 16,8.
             MaxHeight = font × 1.5 line-height × 3 ≈ 90 for size 20, plus padding; TextTrimming
             ellipsises a 200-char overflow instead of pushing the window taller. -->
        <Border x:Name="TextCard" Background="#CC000000" CornerRadius="8"
                Padding="16,8" Visibility="Collapsed"
                MaxWidth="760" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.7" BlurRadius="6" ShadowDepth="2"/>
            </Border.Effect>
            <TextBlock x:Name="Subtitle" Text="{Binding Text}" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="White" FontFamily="Segoe UI" FontSize="20"
                       TextTrimming="CharacterEllipsis"
                       MaxHeight="120"/>
        </Border>
    </Grid>
</Window>
