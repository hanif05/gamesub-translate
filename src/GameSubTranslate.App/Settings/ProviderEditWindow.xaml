<Window x:Class="GameSubTranslate.App.Settings.ProviderEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Provider" Height="320" Width="460" MinHeight="280" MinWidth="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Style="{StaticResource Window.Base}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name *" VerticalAlignment="Center" Margin="0,4"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" Margin="0,4" Padding="4,2"
                 ToolTip="Display name shown in the fallback list."/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Base URL *" VerticalAlignment="Center" Margin="0,4"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="BaseUrlBox" Margin="0,4" Padding="4,2"
                 ToolTip="Example: https://api.openai.com/v1"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Model *" VerticalAlignment="Center" Margin="0,4"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="ModelBox" Margin="0,4" Padding="4,2"
                 ToolTip="Example: gpt-4o-mini"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="API Key *" VerticalAlignment="Center" Margin="0,4"/>
        <PasswordBox Grid.Row="3" Grid.Column="1" x:Name="ApiKeyBox" Margin="0,4" Padding="4,2"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Text="Used as a fallback when the primary provider fails (Network/Provider)."
                   Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>

        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save" Width="80" Margin="0,0,8,0" IsDefault="True" Click="Save_Click"/>
            <Button Content="Cancel" Width="80" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
