<Window x:Class="GameSubTranslate.App.Settings.ProviderEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Provider" Height="360" Width="480" MinHeight="300" MinWidth="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Style="{StaticResource Window.Base}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- T68: header strip. -->
        <Border Grid.Row="0" Padding="16,12" Background="{StaticResource Brush.Bg.Surface}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE968;" FontSize="18"
                           Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center"/>
                <TextBlock x:Name="HeaderTitle" Margin="10,0,0,0" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.Text.Primary}" VerticalAlignment="Center"
                           Text="New Provider"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" VerticalAlignment="Center" Margin="0,4"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" Margin="0,4"
                     ToolTip="Display name shown in the fallback list."/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Base URL" VerticalAlignment="Center" Margin="0,4"/>
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="BaseUrlBox" Margin="0,4"
                     ToolTip="Example: https://api.openai.com/v1"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Model" VerticalAlignment="Center" Margin="0,4"/>
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="ModelBox" Margin="0,4"
                     ToolTip="Example: gpt-4o-mini"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="API Key" VerticalAlignment="Center" Margin="0,4"/>
            <PasswordBox Grid.Row="3" Grid.Column="1" x:Name="ApiKeyBox" Margin="0,4"/>

            <TextBlock Grid.Row="4" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,12,0,0"
                       Foreground="{StaticResource Brush.Text.Muted}" FontSize="12">
                Used as a fallback when the primary provider fails (Network/Provider).
            </TextBlock>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16">
            <Button Content="Save" Width="100" Margin="0,0,6,0" IsDefault="True"
                    Style="{StaticResource Button.Primary}" Click="Save_Click"/>
            <Button Content="Cancel" Width="100" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
