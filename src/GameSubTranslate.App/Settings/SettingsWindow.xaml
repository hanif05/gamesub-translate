<Window x:Class="GameSubTranslate.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="Tabs" Grid.Row="0" Grid.RowSpan="2" Margin="0,0,0,12" MinHeight="420">

            <!-- ============ API & Model ============ -->
            <TabItem Header="API &amp; Model">
                <StackPanel Margin="10">
                    <TextBlock Text="Base URL" FontWeight="SemiBold"/>
                    <TextBox x:Name="BaseUrlBox" Margin="0,4,0,12"/>
                    <TextBlock Text="Model" FontWeight="SemiBold"/>
                    <TextBox x:Name="ModelBox" Margin="0,4,0,12"/>
                    <TextBlock Text="API Key" FontWeight="SemiBold"/>
                    <PasswordBox x:Name="ApiKeyBox" Margin="0,4,0,12"/>
                    <DockPanel>
                        <Button x:Name="TestBtn" Content="Test Connection" DockPanel.Dock="Right"
                                Width="130" Margin="8,0,0,0" Click="TestConnection_Click"/>
                        <TextBlock x:Name="TestResult" VerticalAlignment="Center" TextWrapping="Wrap" Text=""/>
                    </DockPanel>
                </StackPanel>
            </TabItem>

            <!-- ============ Language ============ -->
            <TabItem Header="Language">
                <StackPanel Margin="10">
                    <TextBlock Text="Source language" FontWeight="SemiBold"/>
                    <ComboBox x:Name="SourceLangBox" Margin="0,4,0,12" IsEditable="True">
                        <ComboBoxItem Content="auto"/>
                        <ComboBoxItem Content="en"/>
                        <ComboBoxItem Content="ja"/>
                        <ComboBoxItem Content="ko"/>
                        <ComboBoxItem Content="zh"/>
                        <ComboBoxItem Content="fr"/>
                        <ComboBoxItem Content="de"/>
                        <ComboBoxItem Content="es"/>
                    </ComboBox>
                    <TextBlock Text="Target language" FontWeight="SemiBold"/>
                    <ComboBox x:Name="TargetLangBox" Margin="0,4,0,0" IsEditable="True">
                        <ComboBoxItem Content="id"/>
                        <ComboBoxItem Content="en"/>
                        <ComboBoxItem Content="ja"/>
                        <ComboBoxItem Content="ko"/>
                        <ComboBoxItem Content="zh"/>
                        <ComboBoxItem Content="fr"/>
                        <ComboBoxItem Content="de"/>
                        <ComboBoxItem Content="es"/>
                    </ComboBox>
                </StackPanel>
            </TabItem>

            <!-- ============ Capture ============ -->
            <TabItem Header="Capture">
                <StackPanel Margin="10">
                    <TextBlock Text="Capture interval (ms)" FontWeight="SemiBold"/>
                    <TextBox x:Name="IntervalBox" Margin="0,4,0,12" Width="120" HorizontalAlignment="Left"/>
                    <TextBlock Text="OCR engine" FontWeight="SemiBold"/>
                    <ComboBox x:Name="OcrEngineBox" Margin="0,4,0,0" Width="160" HorizontalAlignment="Left">
                        <ComboBoxItem Content="Tesseract" Tag="Tesseract"/>
                        <ComboBoxItem Content="Vision AI (coming soon)" Tag="VisionAi" IsEnabled="False"/>
                    </ComboBox>
                </StackPanel>
            </TabItem>

            <!-- ============ Overlay ============ -->
            <TabItem Header="Overlay">
                <Grid>
                <StackPanel Margin="10">
                    <DockPanel Margin="0,0,0,12">
                        <Button x:Name="PickPosBtn" Content="Pick Position" DockPanel.Dock="Right"
                                Width="110" Margin="8,0,0,0" Click="PickPosition_Click"/>
                        <TextBlock Text="Overlay position" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="Font family" FontWeight="SemiBold"/>
                    <TextBox x:Name="FontFamilyBox" Margin="0,4,0,12"/>
                    <TextBlock Text="Font size" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                        <TextBlock Text="20" Foreground="Gray" VerticalAlignment="Center"/>
                        <Slider x:Name="FontSizeSlider" Minimum="10" Maximum="60" Width="200"
                                Margin="8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="FontSizeText" Text="60" Foreground="Gray" VerticalAlignment="Center" Width="24"/>
                        <Button x:Name="FontSizePlus" Content="+" Width="28" Margin="4,0,0,0" Click="FontSizePlus_Click"/>
                        <Button x:Name="FontSizeMinus" Content="-" Width="28" Margin="4,0,0,0" Click="FontSizeMinus_Click"/>
                    </StackPanel>
                    <TextBlock Text="Text color" FontWeight="SemiBold"/>
                    <DockPanel Margin="0,4,0,12">
                        <TextBox x:Name="TextColorBox" Width="110" Margin="0,0,8,0"/>
                        <Button x:Name="TextColorBtn" Content="…" Width="32" Click="TextColor_Click"/>
                        <TextBlock Text="Background color" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        <TextBox x:Name="BgColorBox" Width="110" Margin="8,0" VerticalAlignment="Center"/>
                        <Button x:Name="BgColorBtn" Content="…" Width="32" Click="BgColor_Click"/>
                    </DockPanel>
                    <TextBlock Text="Opacity" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Slider x:Name="OpacitySlider" Minimum="0" Maximum="1" Width="200"
                                VerticalAlignment="Center"/>
                        <TextBlock x:Name="OpacityText" Text="1.00" Foreground="Gray" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Popup x:Name="ColorPopup" StaysOpen="False" AllowsTransparency="True">
                    <Border Background="#FF1E1E1E" BorderBrush="Gray" BorderThickness="1" CornerRadius="6" Padding="6">
                        <WrapPanel x:Name="ColorPalette" Width="168"/>
                    </Border>
                </Popup>
                </Grid>
            </TabItem>

            <!-- ============ Hotkeys ============ -->
            <TabItem Header="Hotkeys">
                <StackPanel Margin="10">
                    <DockPanel Margin="0,0,0,8">
                        <Button x:Name="ToggleHotkeyBtn" Content="Change" DockPanel.Dock="Right" Width="80" Click="ToggleHotkey_Change"/>
                        <TextBlock Text="Toggle overlay" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ToggleHotkeyText" Foreground="Gray" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button x:Name="PauseHotkeyBtn" Content="Change" DockPanel.Dock="Right" Width="80" Click="PauseHotkey_Change"/>
                        <TextBlock Text="Pause / resume capture" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PauseHotkeyText" Foreground="Gray" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button x:Name="SettingsHotkeyBtn" Content="Change" DockPanel.Dock="Right" Width="80" Click="SettingsHotkey_Change"/>
                        <TextBlock Text="Open settings" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SettingsHotkeyText" Foreground="Gray" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DockPanel>
                        <Button x:Name="ManualHotkeyBtn" Content="Change" DockPanel.Dock="Right" Width="80" Click="ManualHotkey_Change"/>
                        <TextBlock Text="Manual capture" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ManualHotkeyText" Foreground="Gray" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock x:Name="HotkeyHint" Text="" Foreground="#FFC080" Margin="0,12,0,0"
                               Visibility="Collapsed" TextWrapping="Wrap"/>
                </StackPanel>
            </TabItem>

            <!-- ============ Profiles ============ -->
            <TabItem Header="Profiles">
                <StackPanel Margin="10">
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="New" Width="70" Margin="0,0,4,0" Click="ProfileNew_Click"/>
                            <Button Content="Edit" Width="70" Margin="0,0,4,0" Click="ProfileEdit_Click"/>
                            <Button Content="Delete" Width="70" Click="ProfileDelete_Click"/>
                        </StackPanel>
                        <TextBlock Text="Profiles" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ListBox x:Name="ProfileList" DisplayMemberPath="Name" MinHeight="240"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" Width="90" Margin="0,0,6,0" IsDefault="True" Click="Save_Click"/>
            <Button Content="Cancel" Width="90" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
