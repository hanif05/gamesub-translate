<Window x:Class="GameSubTranslate.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:profiles="clr-namespace:GameSubTranslate.Profiles;assembly=GameSubTranslate.Core"
        xmlns:app="clr-namespace:GameSubTranslate.App"
        Title="GameSubTranslate" Height="500" Width="700" MinHeight="400" MinWidth="560"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource Window.Base}">
    <Window.Resources>
        <!-- F59: profile item template — avatar circle + name + exe + active strip + region badge. -->
        <DataTemplate x:Key="ProfileItemTemplate" DataType="{x:Type profiles:GameProfile}">
            <Grid Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Active indicator: 3px accent strip on the left edge. -->
                <Border x:Name="ActiveStrip" Grid.Column="0" Background="Transparent"/>
                <!-- Avatar: first letter of profile name in a 32x32 circle. -->
                <Border Grid.Column="1" Width="32" Height="32" CornerRadius="16"
                        Background="{StaticResource Brush.Bg.Surface2}" Margin="10,0,10,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name, Converter={x:Static app:ProfileAvatarConverter.Instance}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}"/>
                </Border>
                <!-- Name + executable name stacked. -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,8">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Text.Primary}"/>
                    <TextBlock Text="{Binding ExecutableName}" FontSize="11"
                               Foreground="{StaticResource Brush.Text.Muted}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <!-- Region count badge: small pill on the right. -->
                <Border Grid.Column="3" CornerRadius="9" Padding="8,2" Margin="0,0,12,0"
                        Background="{StaticResource Brush.Bg.Surface2}" VerticalAlignment="Center">
                    <TextBlock Foreground="{StaticResource Brush.Text.Muted}" FontSize="11"
                               Text="{Binding Regions.Count, StringFormat={}{0} regions}"/>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                    <Setter TargetName="ActiveStrip" Property="Background" Value="{StaticResource Brush.Accent}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- F58: header — app title + version. -->
        <Border Grid.Row="0" Padding="16,12" Background="{StaticResource Brush.Bg.Surface}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="GameSubTranslate" FontWeight="SemiBold" FontSize="16"
                           Foreground="{StaticResource Brush.Text.Primary}" VerticalAlignment="Center"/>
                <TextBlock x:Name="VersionText" Margin="8,0,0,0" FontSize="11"
                           Foreground="{StaticResource Brush.Text.Muted}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- F58: main split — sidebar (profiles) | main panel (region + controls). -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource Brush.Bg.Surface}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="12,10" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Profiles" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Text.Primary}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CountText" Margin="8,0,0,0"
                                       Foreground="{StaticResource Brush.Text.Muted}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Grid>
                        <ListBox x:Name="ProfileList" SelectionMode="Single" BorderThickness="0"
                                 ItemTemplate="{StaticResource ProfileItemTemplate}"
                                 SelectionChanged="ProfileList_SelectionChanged"/>
                        <!-- F58: empty state — centered hint when no profile. -->
                        <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="No profiles yet" Foreground="{StaticResource Brush.Text.Muted}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="EmptyHint" Margin="0,4,0,0" FontSize="11"
                                       Foreground="{StaticResource Brush.Text.Muted}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Main panel: region combo, controls, status pill. -->
            <Grid Grid.Column="1" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Active region" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ComboBox x:Name="RegionCombo" Grid.Row="1" MinWidth="240"
                          DisplayMemberPath="Display"
                          SelectionChanged="RegionCombo_SelectionChanged"/>

                <!-- F58: control buttons — Start primary accent, Pause outlined neutral, Stop destructive outlined. -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,20,0,0">
                    <Button x:Name="StartBtn" Content="Start" Width="100" Margin="0,0,8,0"
                            Style="{StaticResource Button.Primary}" Click="Start_Click"/>
                    <Button x:Name="PauseBtn" Content="Pause" Width="100" Margin="0,0,8,0"
                            IsEnabled="False" Click="Pause_Click"/>
                    <Button x:Name="StopBtn" Content="Stop" Width="100"
                            Style="{StaticResource Button.Destructive}" IsEnabled="False" Click="Stop_Click"/>
                </StackPanel>

                <Grid Grid.Row="3" Margin="0,20,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Profile actions" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <WrapPanel Grid.Row="1">
                        <Button Content="New" Width="80" Margin="0,0,6,6" Click="New_Click"/>
                        <Button Content="Edit" Width="80" Margin="0,0,6,6" Click="Edit_Click"/>
                        <Button Content="Duplicate" Width="90" Margin="0,0,6,6" Click="Duplicate_Click"/>
                        <Button Content="Delete" Width="80" Margin="0,0,6,6" Click="Delete_Click"/>
                        <Button Content="Refresh" Width="80" Margin="0,0,0,6" Click="Refresh_Click"/>
                    </WrapPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- F58: status pill — color reflects idle/running/paused/error. -->
        <Border Grid.Row="2" Padding="16,8" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Border DockPanel.Dock="Left" CornerRadius="10" Padding="10,3"
                        Background="{StaticResource Brush.Bg.Surface2}">
                    <TextBlock x:Name="StatusPill" Text="Idle" FontSize="11"
                               Foreground="{StaticResource Brush.Text.Muted}"/>
                </Border>
                <TextBlock x:Name="StatusText" Margin="12,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource Brush.Text.Primary}" Text=""/>
            </DockPanel>
        </Border>

        <!-- F58: bottom strip — version line stays in header; tray hint lives here. -->
        <Border Grid.Row="3" Padding="16,6" Background="{StaticResource Brush.Bg.Surface}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
            <TextBlock Text="Closing this window keeps the app running in the tray."
                       FontSize="11" Foreground="{StaticResource Brush.Text.Muted}"/>
        </Border>
    </Grid>
</Window>
