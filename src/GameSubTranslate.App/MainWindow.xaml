<Window x:Class="GameSubTranslate.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameSubTranslate" Height="500" Width="700"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Profiles" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock x:Name="CountText" Foreground="Gray" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="New Profile" Width="100" Margin="0,0,4,0" Click="New_Click"/>
            <Button Content="Edit" Width="80" Margin="0,0,4,0" Click="Edit_Click"/>
            <Button Content="Duplicate" Width="90" Margin="0,0,4,0" Click="Duplicate_Click"/>
            <Button Content="Delete" Width="80" Margin="0,0,4,0" Click="Delete_Click"/>
            <Button Content="Refresh" Width="80" Click="Refresh_Click"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Active region:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="RegionCombo" MinWidth="220" DisplayMemberPath="Display" SelectionChanged="RegionCombo_SelectionChanged"/>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="StartBtn" Content="Start" Width="80" Margin="0,0,4,0" Click="Start_Click"/>
                <Button x:Name="PauseBtn" Content="Pause" Width="80" Margin="0,0,4,0" Click="Pause_Click" IsEnabled="False"/>
                <Button x:Name="StopBtn" Content="Stop" Width="80" Click="Stop_Click" IsEnabled="False"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Foreground="Gray" VerticalAlignment="Center" Text="Idle"/>
        </DockPanel>

        <ListBox x:Name="ProfileList" SelectionMode="Single" DisplayMemberPath="Name" SelectionChanged="ProfileList_SelectionChanged"/>
    </DockPanel>
</Window>
