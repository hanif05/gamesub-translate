<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>GameSubTranslate.Prototype</RootNamespace>
    <AssemblyName>GameSubTranslate.Prototype</AssemblyName>
    <!-- Transitive from Core's Win2D → WindowsAppSDK; needed for `dotnet build` without VS. -->
    <EnableCoreMrtTooling>false</EnableCoreMrtTooling>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameSubTranslate.Core\GameSubTranslate.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Direct refs needed so the Sdcb native runtime DLLs (paddle_inference.dll + CUDA
         deps) get copied into the Prototype's output dir. NuGet only emits <None Include>
         targets for direct refs — transitive refs (via Core) won't trigger the copy.
         Same gotcha the old Paddle.Runtime.win_x64 had, per CLAUDE.md. -->
    <PackageReference Include="Sdcb.PaddleOCR" Version="2.7.0.3" />
    <PackageReference Include="Sdcb.PaddleOCR.Models.Online" Version="2.7.0" />
    <PackageReference Include="Sdcb.PaddleInference.runtime.win64.cu120-sm61-75" Version="2.6.1" />
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20240616" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20240616" />
  </ItemGroup>

</Project>
